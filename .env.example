# =============================================================================
# Landing de referidos — Speak Easy
# Copia este archivo como `.env.local` y rellena los valores reales.
# `.env.local` NUNCA se sube a git. En Vercel, carga estas mismas variables en
# Settings → Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# Sesión
# -----------------------------------------------------------------------------
# Clave para firmar la cookie que recuerda qué estudiante está refiriendo
# (JWT HS256). Mínimo 32 caracteres.
# Genérala con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria-de-32-o-mas-caracteres

# -----------------------------------------------------------------------------
# PostgreSQL (conexión por host)
# Es la misma base que usa landing-auth-zoom; lo que cambia es el esquema.
# -----------------------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=tu-password
PGDATABASE=speakeasy

# Esquema donde viven las tablas de este proyecto (estudiantes y
# persona_referida), separadas de `auth_lanzamiento` y del resto de la base.
PGSCHEMA=referidos

# SSL de la conexión: `require` (proveedores gestionados: Neon, Supabase, RDS,
# Railway, Render...) o `disable` (Postgres local o red privada).
# Con `require` se cifra la conexión sin verificar la cadena de certificados
# (rejectUnauthorized:false), que es lo que aceptan esos proveedores.
PGSSL=require

# Nº máximo de conexiones del pool. En Vercel (serverless) conviene un valor
# bajo (1–3) y usar el endpoint "pooler"/pgBouncer de tu proveedor.
PGPOOL_MAX=3
